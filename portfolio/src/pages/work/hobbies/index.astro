---
import BaseLayout from '../../../layouts/BaseLayout.astro';

// We duplicate the 4 images to create an array of 8. 
// This gives GSAP enough DOM nodes to cycle through for rapid mouse movements without stuttering.
const baseImages = [
  "https://images.unsplash.com/photo-1485846234645-a62644f84728?q=80&w=600",
  "https://images.unsplash.com/photo-1601506521937-0121a7fc2a6b?q=80&w=600",
  "https://images.unsplash.com/photo-1574717024653-61fd2cf4d44d?q=80&w=600",
  "https://images.unsplash.com/photo-1535016120720-40c746a6580c?q=80&w=600"
];
const trailImages = [...baseImages, ...baseImages];
---
<BaseLayout title="Framed By Yash | Digital Portfolio">
  
  <!-- Solid Base Background -->
  <div class="solid-base"></div>

  <!-- Film Grain Overlay -->
  <div class="film-grain pointer-events-none"></div>

  <!-- Minimalist Camera Viewfinder (4 Corners Removed) -->
  <div class="camera-hud pointer-events-none">
    <div class="hud-crosshair"></div>
  </div>

  <!-- Ambient Dark Background + Scattered Icons -->
  <div class="ambient-background cinematic-pattern"></div>
  
  <!-- Image Trail Container (8 Images) -->
  <div class="trail-container" id="contentRef">
    {trailImages.map((url, index) => (
      <img class="trail-image" src={url} alt={`trail element ${index + 1}`} loading="eager" />
    ))}
  </div>
  
  <!-- FOLD 1: Full Screen Hero Intro -->
  <section class="cinematic-hero">
    <div class="hero-content">
      <div class="reveal-mask">
        <span class="label difference-text">Director & Editor</span>
      </div>
      
      <div class="reveal-mask">
        <h1 class="display-title difference-text">
          <a href="https://www.instagram.com/framed.by.yash/" target="_blank" rel="noopener noreferrer" class="pointer-events-auto handle-link">
            @framed.by.yash
          </a>
        </h1>
      </div>
      
      <div class="reveal-mask">
        <p class="description difference-text">
          Cinematic video editing, visual storytelling, and digital media production.
        </p>
      </div>
    </div>
    
    <!-- Scroll indicator -->
    <div class="scroll-indicator">
      <span>Scroll for Reels</span>
      <div class="scroll-line"></div>
    </div>
  </section>

  <!-- FOLD 2: Video Portfolio Section -->
  <section class="video-section">
    <div class="content-wrapper">
      <div class="media-showcase fade-in-up pointer-events-auto">
        <div class="cinematic-frame">
          <div class="frame-overlay">
            <span class="timecode">PROJECT // 01</span>
            <span class="resolution">4K</span>
          </div>
          <video controls preload="metadata" poster="/videos/featured-thumbnail.jpg" class="video-asset">
            <source src="/videos/featured.mp4" type="video/mp4" />
          </video>
        </div>

        <div class="reels-grid">
          <div class="cinematic-frame vertical">
            <div class="frame-overlay minimal"><span class="timecode">SHORT // 01</span></div>
            <video controls preload="metadata" poster="/videos/reel-01-thumbnail.jpg" class="video-asset">
              <source src="/videos/reel-01.mp4" type="video/mp4" />
            </video>
          </div>
          
          <div class="cinematic-frame vertical">
            <div class="frame-overlay minimal"><span class="timecode">SHORT // 02</span></div>
            <video controls preload="metadata" poster="/videos/reel-02-thumbnail.jpg" class="video-asset">
              <source src="/videos/reel-02.mp4" type="video/mp4" />
            </video>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<!-- GSAP Animation Scripts -->
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    gsap.from(".reveal-mask > *", { y: 120, opacity: 0, duration: 1.2, stagger: 0.15, ease: "power4.out", delay: 0.1 });
    
    const contentRef = document.getElementById("contentRef");
    const imagesRef = Array.from(contentRef.querySelectorAll("img"));
    const threshold = 50;
    const duration = 1.6;
    const imgWidth = 250;
    const imgHeight = 320;
    
    let mousePos = { x: 0, y: 0 };
    let cacheMousePos = { x: 0, y: 0 };
    let lastMousePos = { x: 0, y: 0 };
    let zIndexVal = 1;
    let imgPosition = 0;
    let parentSize = { width: 0, height: 0 };
    let isInitialized = false;

    if (imagesRef.length === 0) return;

    const calcParentSize = () => { parentSize = { width: window.innerWidth, height: window.innerHeight }; };
    const handleMouseMove = (e) => {
      mousePos = { x: e.clientX, y: e.clientY };
      if (!isInitialized) {
        cacheMousePos = { ...mousePos }; lastMousePos = { ...mousePos }; isInitialized = true;
      }
    };

    calcParentSize();
    window.addEventListener("mousemove", handleMouseMove);
    window.addEventListener("resize", calcParentSize);

    const lerp = (a, b, n) => (1 - n) * a + n * b;
    const getMouseDistance = () => Math.hypot(mousePos.x - lastMousePos.x, mousePos.y - lastMousePos.y);

    const renderImages = () => {
      if (!isInitialized) { requestAnimationFrame(renderImages); return; }
      const distance = getMouseDistance();
      cacheMousePos.x = lerp(cacheMousePos.x, mousePos.x, 0.15);
      cacheMousePos.y = lerp(cacheMousePos.y, mousePos.y, 0.15);

      if (distance > threshold) {
        showNextImage();
        zIndexVal += 1;
        imgPosition = (imgPosition + 1) % imagesRef.length;
        lastMousePos = { ...mousePos };
      }
      requestAnimationFrame(renderImages);
    };

    const showNextImage = () => {
      const img = imagesRef[imgPosition];
      if (!img) return;
      gsap.killTweensOf(img);
      const fadeOutDelay = duration - 1 > 0 ? duration - 1 : 0.4;
      gsap.timeline()
        .set(img, { startAt: { opacity: 0 }, opacity: 1, zIndex: zIndexVal, x: cacheMousePos.x - imgWidth / 2, y: cacheMousePos.y - imgHeight / 2, force3D: true })
        .to(img, { duration: duration, ease: "expo.out", x: mousePos.x - imgWidth / 2, y: mousePos.y - imgHeight / 2, force3D: true })
        .to(img, { duration: 1, ease: "power1.out", opacity: 0 }, fadeOutDelay)
        .to(img, { duration: 1, ease: "quint.inOut", y: `+=${parentSize.height + imgHeight / 2}`, force3D: true }, fadeOutDelay);
    };
    requestAnimationFrame(renderImages);
  });
</script>

<style>
  .pointer-events-none { pointer-events: none; }
  .pointer-events-auto { pointer-events: auto; }

  /* Blocks the global site grid from bleeding through */
  .solid-base {
    position: fixed; top: 0; left: 0;
    width: 100vw; height: 100vh;
    background-color: #050505 !important;
    z-index: -3; pointer-events: none;
  }

  /* Ambient dark background with scattered, randomized cinematic icons */
  .ambient-background {
    position: fixed; top: 0; left: 0;
    width: 100%; height: 100%;
    z-index: -2; pointer-events: none;
  }
  
  .cinematic-pattern {
    background-image: url("data:image/svg+xml,%3Csvg width='600' height='600' viewBox='0 0 600 600' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' stroke='%23ffffff' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round' stroke-opacity='0.04'%3E%3C!-- Scattered Camera 1 --%3E%3Cg transform='translate(50, 80) rotate(15)'%3E%3Cpath d='M23 7l-7 5 7 5V7zM1 5h14c1.1 0 2 .9 2 2v10c0 1.1-.9 2-2 2H1c-1.1 0-2-.9-2-2V7c0-1.1.9-2 2-2z'/%3E%3C/g%3E%3C!-- Scattered Camera 2 --%3E%3Cg transform='translate(400, 200) rotate(-25)'%3E%3Cpath d='M23 7l-7 5 7 5V7zM1 5h14c1.1 0 2 .9 2 2v10c0 1.1-.9 2-2 2H1c-1.1 0-2-.9-2-2V7c0-1.1.9-2 2-2z'/%3E%3C/g%3E%3C!-- Scattered Film 1 --%3E%3Cg transform='translate(150, 300) rotate(-10)'%3E%3Crect x='2' y='2' width='20' height='20' rx='2.18' ry='2.18'/%3E%3Cline x1='7' y1='2' x2='7' y2='22'/%3E%3Cline x1='17' y1='2' x2='17' y2='22'/%3E%3Cline x1='2' y1='12' x2='22' y2='12'/%3E%3C/g%3E%3C!-- Scattered Film 2 --%3E%3Cg transform='translate(500, 500) rotate(45)'%3E%3Crect x='2' y='2' width='20' height='20' rx='2.18' ry='2.18'/%3E%3Cline x1='7' y1='2' x2='7' y2='22'/%3E%3Cline x1='17' y1='2' x2='17' y2='22'/%3E%3Cline x1='2' y1='12' x2='22' y2='12'/%3E%3C/g%3E%3C!-- Scattered Scissors 1 --%3E%3Cg transform='translate(300, 100) rotate(60)'%3E%3Ccircle cx='6' cy='6' r='3'/%3E%3Ccircle cx='6' cy='18' r='3'/%3E%3Cline x1='20' y1='4' x2='8.12' y2='13.88'/%3E%3Cline x1='14.47' y1='14.48' x2='20' y2='20'/%3E%3Cline x1='8.12' y1='10.12' x2='12' y2='12'/%3E%3C/g%3E%3C!-- Scattered Scissors 2 --%3E%3Cg transform='translate(80, 500) rotate(-30)'%3E%3Ccircle cx='6' cy='6' r='3'/%3E%3Ccircle cx='6' cy='18' r='3'/%3E%3Cline x1='20' y1='4' x2='8.12' y2='13.88'/%3E%3Cline x1='14.47' y1='14.48' x2='20' y2='20'/%3E%3Cline x1='8.12' y1='10.12' x2='12' y2='12'/%3E%3C/g%3E%3C!-- Scattered Play 1 --%3E%3Cg transform='translate(250, 450) rotate(-15)'%3E%3Cpolygon points='5 3 19 12 5 21 5 3'/%3E%3C/g%3E%3C!-- Scattered Play 2 --%3E%3Cg transform='translate(450, 50) rotate(20)'%3E%3Cpolygon points='5 3 19 12 5 21 5 3'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    background-size: 600px 600px;
  }

  .film-grain {
    position: fixed; top: 0; left: 0;
    width: 100%; height: 100%;
    z-index: 100; opacity: 0.05; pointer-events: none;
    background-image: url('data:image/svg+xml;utf8,%3Csvg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg"%3E%3Cfilter id="noiseFilter"%3E%3CfeTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="3" stitchTiles="stitch"/%3E%3C/filter%3E%3Crect width="100%25" height="100%25" filter="url(%23noiseFilter)"/%3E%3C/svg%3E');
  }

  /* --- CAMERA VIEWFINDER HUD (Corners Removed) --- */
  .camera-hud {
    position: fixed; top: 0; left: 0;
    width: 100vw; height: 100vh;
    z-index: 40; padding: 40px;
    box-sizing: border-box;
  }

  .hud-crosshair { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 40px; height: 40px; }
  .hud-crosshair::before, .hud-crosshair::after { content: ''; position: absolute; background: rgba(255,255,255,0.2); }
  .hud-crosshair::before { top: 50%; left: 0; width: 100%; height: 1px; }
  .hud-crosshair::after { top: 0; left: 50%; width: 1px; height: 100%; }

  /* --- IMAGE TRAIL --- */
  .trail-container {
    --image-width: 250px; --image-height: 320px;
    position: fixed; top: 0; left: 0;
    width: 100vw; height: 100vh;
    z-index: 0; /* Lowered below your global navigation header */
    pointer-events: none; /* Safely passes mouse events through to the navigation tabs */
    overflow: hidden; 
    isolation: isolate;
  }
  .trail-image {
    position: absolute; top: 0; left: 0;
    height: var(--image-height); width: var(--image-width);
    object-fit: cover; opacity: 0;
    will-change: transform, opacity; pointer-events: none;
    border-radius: 4px; box-shadow: 0 20px 40px rgba(0,0,0,0.8);
  }

  /* --- FOLD 1: HERO SECTION --- */
  .cinematic-hero {
    position: relative; height: 100vh; display: flex; flex-direction: column;
    justify-content: center; align-items: center; z-index: 50; pointer-events: none;
  }
  .hero-content { text-align: center; display: flex; flex-direction: column; align-items: center; }
  
  .difference-text { color: #ffffff; mix-blend-mode: difference; }
  
  .handle-link { 
    color: inherit; text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.3);
    text-underline-offset: 12px; text-decoration-thickness: 3px;
    transition: all 0.3s ease; 
  }
  .handle-link:hover { opacity: 0.85; text-decoration-color: rgba(255, 255, 255, 1); }

  .reveal-mask { overflow: hidden; }
  .label { font-family: 'Oswald', sans-serif; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.2em; display: block; margin-bottom: var(--space-md); }
  .display-title { font-size: clamp(3rem, 7vw, 6rem); margin-bottom: var(--space-md); letter-spacing: -0.01em; text-transform: lowercase; line-height: 1; }
  .description { font-size: clamp(1.1rem, 2vw, 1.25rem); margin-bottom: var(--space-xl); max-width: 600px; line-height: 1.6; }

  /* Scroll Indicator */
  .scroll-indicator {
    position: absolute; bottom: 40px; display: flex; flex-direction: column; align-items: center; gap: 10px;
    color: rgba(255,255,255,0.5); font-family: 'Fira Code', monospace; font-size: 0.75rem;
    text-transform: uppercase; letter-spacing: 0.1em; mix-blend-mode: difference;
  }
  .scroll-line { width: 1px; height: 40px; background: linear-gradient(to bottom, rgba(255,255,255,0.8), transparent); }

  /* --- FOLD 2: VIDEO SECTION --- */
  .video-section {
    position: relative; z-index: 60; background: #050505;
    padding: var(--space-2xl) var(--space-md); border-top: 1px solid rgba(255,255,255,0.05);
  }
  
  .content-wrapper { max-width: 1000px; width: 100%; margin: 0 auto; text-align: center; }

  .media-showcase { display: flex; flex-direction: column; gap: var(--space-lg); }
  .cinematic-frame { position: relative; background: #050505; border: 1px solid rgba(255, 255, 255, 0.1); box-shadow: 0 30px 60px rgba(0,0,0,0.9); overflow: hidden; transition: transform 0.4s ease, border-color 0.4s ease; }
  .cinematic-frame:hover { transform: translateY(-5px); border-color: rgba(255, 255, 255, 0.3); }

  .frame-overlay { position: absolute; top: 0; left: 0; width: 100%; padding: 15px 20px; display: flex; justify-content: space-between; pointer-events: none; z-index: 30; background: linear-gradient(180deg, rgba(0,0,0,0.7) 0%, transparent 100%); }
  .frame-overlay.minimal { justify-content: center; }

  .timecode, .resolution { font-family: 'Fira Code', monospace; font-size: 0.75rem; color: rgba(255,255,255,0.7); letter-spacing: 0.1em; }
  .timecode { display: flex; align-items: center; gap: 8px; }

  .video-asset { width: 100%; display: block; aspect-ratio: 16/9; object-fit: cover; }
  .cinematic-frame.vertical .video-asset { aspect-ratio: 9/16; }

  .reels-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-lg); }
  
  @media (max-width: 600px) { 
    .reels-grid { grid-template-columns: 1fr; } 
  }
</style>