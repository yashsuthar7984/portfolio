---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout title="Content Creation">
  <section class="hobbies-section">
    <div class="content-wrapper">
      <h1 class="title">Content Creation</h1>
      <p class="description">
        Cinematic video editing, visual storytelling, and digital media production.
      </p>
      
      <!-- Instagram External Link -->
      <a href="https://www.instagram.com/framed.by.yash/" target="_blank" rel="noopener noreferrer" class="social-link">
        View My Instagram ↗
      </a>
      
      <!-- Media Showcase -->
      <div class="media-showcase">
        
        <!-- Featured 16:9 Video -->
        <div class="media-frame">
          <div class="frame-header">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
            <span class="file-name">REC // FEATURED_EDIT.MP4</span>
          </div>
          <div class="frame-body">
            <video controls preload="metadata" style="width: 100%; aspect-ratio: 16/9; background: #000; display: block;">
              <source src="/videos/featured.mp4" type="video/mp4" />
            </video>
          </div>
        </div>

        <!-- 9:16 Reels / Shorts Grid -->
        <div class="reels-grid">
          <!-- Reel 1 -->
          <div class="media-frame">
            <div class="frame-header">
              <span class="file-name">REEL_01.MP4</span>
            </div>
            <div class="frame-body">
              <video controls preload="metadata" style="width: 100%; aspect-ratio: 9/16; background: #000; display: block;">
                <source src="/videos/reel-01.mp4" type="video/mp4" />
              </video>
            </div>
          </div>
          <!-- Reel 2 -->
          <div class="media-frame">
            <div class="frame-header">
              <span class="file-name">REEL_02.MP4</span>
            </div>
            <div class="frame-body">
              <video controls preload="metadata" style="width: 100%; aspect-ratio: 9/16; background: #000; display: block;">
                <source src="/videos/reel-02.mp4" type="video/mp4" />
              </video>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Base Layout */
  .hobbies-section {
    padding: var(--space-2xl) 0;
    display: flex;
    justify-content: center;
    min-height: 70vh;
  }
  
  .content-wrapper {
    max-width: 900px;
    width: 100%;
    margin: 0 auto;
    padding: 0 var(--space-md);
    text-align: center;
  }

  /* Typography */
  .title {
    font-size: clamp(3rem, 6vw, 5rem);
    margin-bottom: var(--space-md);
    letter-spacing: -0.02em;
  }

  .description {
    color: var(--color-text-muted);
    font-size: 1.15rem;
    margin-bottom: var(--space-md);
  }

  /* Instagram Link Button */
  .social-link {
    display: inline-block;
    padding: var(--space-sm) var(--space-lg);
    border: 1px solid var(--color-accent);
    color: var(--color-text-primary);
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 4px;
    transition: all var(--transition-smooth);
    margin-bottom: var(--space-xl);
  }

  .social-link:hover {
    background: var(--color-accent);
    color: white;
  }

  /* Media Showcase UI */
  .media-showcase {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .media-frame {
    background: #111;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    overflow: hidden;
    text-align: left;
  }

  .frame-header {
    background: #1a1a1a;
    padding: 12px 15px;
    display: flex;
    align-items: center;
    gap: 8px;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }

  .dot { width: 12px; height: 12px; border-radius: 50%; }
  .dot.red { background: #ff5f56; }
  .dot.yellow { background: #ffbd2e; }
  .dot.green { background: #27c93f; }

  .file-name {
    margin-left: auto;
    margin-right: auto;
    font-family: monospace;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
  }

  .frame-body {
    background: #050505;
    padding: 0;
  }

  /* Grid for Reels / Shorts */
  .reels-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }

  /* Responsive Mobile Adjustment */
  @media (max-width: 600px) {
    .reels-grid {
      grid-template-columns: 1fr;
    }
  }
</style>