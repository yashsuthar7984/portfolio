---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { featuredVideo, shortVideos } from '../../../data/videos.js';
---
<BaseLayout title="@framed.by.yash | Video Editing & Content">
  <main class="creator-hub">
    
    <!-- Header Section -->
    <header class="hub-header fade-in">
      
      <!-- Top Right REC Indicator -->
      <div class="rec-indicator">
        <div class="rec-flex">
          <span class="blink-dot"></span> REC
        </div>
        <div class="rec-meta">1080P &bull; 24FPS</div>
      </div>

      <!-- Editorial Handle (Forced to single line) -->
      <h1 class="massive-handle">@framed.by.yash</h1>
      
      <div class="meta-tags">
        <span class="tag">Video Editing &amp; Content</span>
      </div>
      
      <p class="desc">
        Learning video editing, experimenting with cuts, and creating digital video content. <br>
        A creative passion by Yash Suthar.
      </p>
      
      <div class="actions">
        <a href="https://www.instagram.com/framed.by.yash/" target="_blank" rel="noopener noreferrer" class="insta-btn">
          Explore on Instagram ↗
        </a>
      </div>
    </header>

    <!-- Asymmetric Video Gallery -->
    <section class="video-gallery fade-in">
      
      <!-- Featured 16:9 Cut (Cloudinary Stream) -->
      <div class="video-card featured">
        <div class="player-wrapper">
          <video controls preload="metadata" poster={featuredVideo.posterUrl} class="video-asset wide">
            <source src={featuredVideo.videoUrl} type="video/mp4" />
          </video>
        </div>
      </div>

      <!-- Shorts / Reels (Cloudinary Streams) -->
      {shortVideos.map((short) => (
        <div class="video-card short">
          <div class="player-wrapper">
            <video controls preload="metadata" poster={short.posterUrl} class="video-asset tall">
              <source src={short.videoUrl} type="video/mp4" />
            </video>
          </div>
        </div>
      ))}

    </section>
  </main>
</BaseLayout>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    gsap.from(".fade-in", { 
      y: 40, 
      opacity: 0, 
      duration: 1.2, 
      stagger: 0.2, 
      ease: "power3.out", 
      delay: 0.1 
    });
  });
</script>

<style>
  /* Layout Constraints */
  .creator-hub {
    max-width: 1400px;
    margin: 0 auto;
    padding: 12vh 40px 8vh;
    position: relative;
    z-index: 10;
  }

  /* Header Section */
  .hub-header {
    position: relative;
    margin-bottom: 60px;
  }

  .rec-indicator {
    position: absolute;
    top: 0;
    right: 0;
    text-align: right;
    font-family: 'Inter', sans-serif;
  }

  .rec-flex {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    color: #ff3333;
    font-weight: 600;
    letter-spacing: 0.1em;
    font-size: 1.1rem;
  }

  .blink-dot {
    width: 10px; height: 10px;
    background-color: #ff3333;
    border-radius: 50%;
    animation: pulse 1.5s infinite;
  }

  .static-dot {
    display: inline-block;
    width: 8px; height: 8px;
    background-color: #ff3333;
    border-radius: 50%;
  }

  .rec-meta {
    color: var(--color-text-muted);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    margin-top: 4px;
  }

  @keyframes pulse {
    0% { opacity: 1; box-shadow: 0 0 0 0 rgba(255, 51, 51, 0.7); }
    70% { opacity: 0.3; box-shadow: 0 0 0 10px rgba(255, 51, 51, 0); }
    100% { opacity: 1; box-shadow: 0 0 0 0 rgba(255, 51, 51, 0); }
  }

  /* Typography */
  .massive-handle {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(2rem, 8vw, 6.5rem); 
    line-height: 1;
    color: var(--color-text-primary);
    margin-bottom: 30px;
    letter-spacing: -0.02em;
    white-space: nowrap; /* Forces text onto a single line */
  }

  .meta-tags {
    margin-bottom: 20px;
  }

  .tag {
    display: inline-block;
    padding: 4px 14px;
    background: rgba(0, 0, 0, 0.04);
    border: 1px solid var(--color-border);
    border-radius: 0;
    font-family: var(--font-code);
    font-size: 0.78rem;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
  }

  .desc {
    color: var(--color-text-muted);
    font-family: var(--font-text);
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 520px;
    margin-bottom: 30px;
  }

  .insta-btn {
    display: inline-block;
    padding: 11px 24px;
    background: #111111;
    border: none;
    border-radius: 0;
    color: #ffffff;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all var(--transition-smooth);
  }

  .insta-btn:hover {
    background: #2a2a2a;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.15);
  }

  /* Video Gallery Grid */
  .video-gallery {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 20px;
    align-items: stretch;
  }

  .video-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-smooth), border-color var(--transition-smooth), box-shadow var(--transition-smooth);
  }

  .video-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-border-hover);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.06);
  }

  .card-header, .card-footer {
    display: flex;
    justify-content: space-between;
    font-family: 'Fira Code', monospace;
    font-size: 0.75rem;
    color: #777;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card-header { margin-bottom: 12px; }
  .card-footer { margin-top: 12px; }

  .footer-right {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .player-wrapper {
    position: relative;
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
    background: #000;
    flex-grow: 1;
    display: flex;
    align-items: center;
  }

  .rec-badge {
    position: absolute;
    top: 12px; right: 12px;
    display: flex;
    align-items: center;
    gap: 6px;
    color: #ff3333;
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    z-index: 10;
    background: rgba(0,0,0,0.5);
    padding: 4px 8px;
    border-radius: 4px;
    pointer-events: none;
  }

  .video-asset {
    width: 100%;
    display: block;
    object-fit: cover;
  }

  .video-asset.wide { aspect-ratio: 16/9; }
  .video-asset.tall { aspect-ratio: 9/16; }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .video-gallery {
      grid-template-columns: 1fr 1fr;
    }
    .featured {
      grid-column: span 2;
    }
  }

  @media (max-width: 768px) {
    .creator-hub { padding: 10vh 20px 5vh; }
    
    .massive-handle { 
      font-size: clamp(2rem, 12vw, 4rem); 
      white-space: normal; 
      word-break: break-word;
    }
    
    .video-gallery { grid-template-columns: 1fr; }
    .featured { grid-column: span 1; }
    .rec-indicator { position: relative; text-align: left; margin-bottom: 20px; }
    .rec-flex { justify-content: flex-start; }
  }
</style>