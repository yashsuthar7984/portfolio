---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout title="Digital Portfolio">
  
  <!-- Cinematic Depth Layers -->
  <div class="ambient-background"></div>
  
  <section class="cinematic-hero">
    <div class="content-wrapper">
      
      <div class="reveal-mask">
        <span class="label">02 // Digital Portfolio</span>
      </div>
      
      <div class="reveal-mask">
        <h1 class="display-title">Content Creation</h1>
      </div>
      
      <div class="reveal-mask">
        <p class="description">
          Cinematic video editing, visual storytelling, and digital media production.
        </p>
      </div>
      
      <div class="reveal-mask">
        <!-- Instagram External Link -->
        <a href="https://www.instagram.com/framed.by.yash/" target="_blank" rel="noopener noreferrer" class="social-link">
          View My Instagram ↗
        </a>
      </div>
      
      <!-- Media Showcase -->
      <div class="media-showcase fade-in-up">
        
        <!-- Featured 16:9 Video -->
        <div class="media-frame">
          <div class="frame-header">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
            <span class="file-name">REC // FEATURED_EDIT.MP4</span>
          </div>
          <div class="frame-body">
            <video controls preload="metadata" poster="/videos/featured-thumbnail.jpg" style="width: 100%; aspect-ratio: 16/9; background: #000; display: block;">
              <source src="/videos/featured.mp4" type="video/mp4" />
            </video>
          </div>
        </div>

        <!-- 9:16 Reels / Shorts Grid -->
        <div class="reels-grid">
          <div class="media-frame">
            <div class="frame-header">
              <span class="file-name">REEL_01.MP4</span>
            </div>
            <div class="frame-body">
              <video controls preload="metadata" poster="/videos/reel-01-thumbnail.jpg" style="width: 100%; aspect-ratio: 9/16; background: #000; display: block;">
                <source src="/videos/reel-01.mp4" type="video/mp4" />
              </video>
            </div>
          </div>
          
          <div class="media-frame">
            <div class="frame-header">
              <span class="file-name">REEL_02.MP4</span>
            </div>
            <div class="frame-body">
              <video controls preload="metadata" poster="/videos/reel-02-thumbnail.jpg" style="width: 100%; aspect-ratio: 9/16; background: #000; display: block;">
                <source src="/videos/reel-02.mp4" type="video/mp4" />
              </video>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>

<!-- GSAP Animation Scripts -->
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    gsap.from(".reveal-mask > *", {
      y: 120,
      opacity: 0,
      duration: 1.2,
      stagger: 0.15,
      ease: "power4.out",
      delay: 0.1
    });
    
    // Upgraded animation: floats up and scales inward for a 3D feel
    gsap.from(".fade-in-up", {
      y: 80,
      scale: 0.95,
      opacity: 0,
      duration: 1.5,
      ease: "power3.out",
      delay: 0.5
    });
  });
</script>

<style>
  /* Ambient Depth Layers */
  .ambient-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    /* Adds a subtle red/accent glow in the center and a dark architectural grid */
    background: 
      radial-gradient(circle at 50% 30%, rgba(255, 60, 60, 0.05) 0%, transparent 60%),
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 100% 100%, 40px 40px, 40px 40px;
    z-index: -1;
    pointer-events: none;
  }

  .cinematic-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: 15vh var(--space-lg) var(--space-2xl);
    margin-top: -80px;
  }
  
  .content-wrapper {
    max-width: 1000px;
    width: 100%;
    margin: 0 auto;
    text-align: center;
  }

  .reveal-mask {
    overflow: hidden;
  }

  .label {
    font-family: 'Oswald', sans-serif;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-accent);
    display: block;
    margin-bottom: var(--space-md);
    text-shadow: 0 0 10px rgba(255, 60, 60, 0.3); /* Slight glow on the red text */
  }

  .display-title {
    font-size: clamp(3.5rem, 8vw, 7.5rem);
    margin-bottom: var(--space-md);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    line-height: 0.95;
    text-shadow: 0 10px 30px rgba(0,0,0,0.8);
  }

  .description {
    color: var(--color-text-muted);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    margin-bottom: var(--space-xl);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .social-link {
    display: inline-block;
    padding: var(--space-sm) var(--space-lg);
    border: 1px solid var(--color-accent);
    color: var(--color-text-primary);
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 4px;
    transition: all var(--transition-smooth);
    margin-bottom: var(--space-2xl);
    background: rgba(255, 60, 60, 0.05); /* Slight tint to the button */
  }

  .social-link:hover {
    background: var(--color-accent);
    color: white;
    box-shadow: 0 0 20px rgba(255, 60, 60, 0.4);
  }

  .media-showcase {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .media-frame {
    background: #111;
    /* Adds a brighter frosted border and a deep glowing shadow */
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    box-shadow: 0 30px 60px rgba(0,0,0,0.9), 0 0 40px rgba(255, 255, 255, 0.03);
    overflow: hidden;
    text-align: left;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  
  .media-frame:hover {
    transform: translateY(-5px);
    box-shadow: 0 40px 70px rgba(0,0,0,1), 0 0 50px rgba(255, 60, 60, 0.1);
  }

  .frame-header {
    background: linear-gradient(180deg, #222 0%, #151515 100%);
    padding: 12px 15px;
    display: flex;
    align-items: center;
    gap: 8px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .dot { width: 12px; height: 12px; border-radius: 50%; box-shadow: inset 0 1px 3px rgba(0,0,0,0.5); }
  .dot.red { background: #ff5f56; }
  .dot.yellow { background: #ffbd2e; }
  .dot.green { background: #27c93f; }

  .file-name {
    margin-left: auto;
    margin-right: auto;
    font-family: monospace;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
  }

  .frame-body {
    background: #050505;
    padding: 0;
  }

  .reels-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }

  @media (max-width: 600px) {
    .reels-grid {
      grid-template-columns: 1fr;
    }
  }
</style>