---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Code Work"
  description="Software development projects, backend systems, and technical repositories by Yash Suthar."
>
  <section class="code-section">
    <div class="content-wrapper">
      
      <!-- Header -->
      <header class="section-header fade-in">
        <h1 class="title">Code</h1>
        <p class="description">
          Engineering secure, resilient, and performant backend systems in Python and Java.
        </p>

        <a href="https://github.com/yashsuthar7984" target="_blank" rel="noopener noreferrer" class="github-cta-btn">
          <span>Explore My GitHub</span>
          <span class="btn-arrow">↗</span>
        </a>
      </header>
      
      <!-- Honest Repositories Status Card (No Demo/Fake Projects) -->
      <div class="repo-window fade-in">
        <div class="window-header">
          <div class="dots-row">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
            <span class="window-title">github_sync.py</span>
          </div>
        </div>

        <div class="window-body">
          <div class="empty-repo-icon">&#128187;</div>
          <h3>No Projects Yet</h3>
          <p class="repo-note">
            Personal software projects, backend tools, and repositories are currently in active development and will be published here once ready.
          </p>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  .code-section {
    padding: var(--space-2xl) var(--space-md);
    display: flex;
    justify-content: center;
    min-height: 80vh;
  }
  
  .content-wrapper {
    max-width: 740px;
    width: 100%;
    margin: 0 auto;
    text-align: center;
  }

  .section-header {
    margin-bottom: var(--space-xl);
  }

  .badge-row {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-xs);
  }

  .terminal-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 14px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    font-family: 'Fira Code', monospace;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .status-dot {
    width: 7px;
    height: 7px;
    background-color: var(--color-accent);
    border-radius: 50%;
  }

  .title {
    font-size: clamp(3rem, 6vw, 4.8rem);
    margin-bottom: var(--space-xs);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .description {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    line-height: 1.6;
    max-width: 580px;
    margin: 0 auto var(--space-lg);
  }

  .github-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 26px;
    color: #ffffff;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 4px;
    transition: all var(--transition-smooth);
    background: linear-gradient(180deg, #2a2c30 0%, #111214 100%);
    border: 1px solid #484b54;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.32), 0 4px 14px rgba(0, 0, 0, 0.14);
    cursor: pointer;
    text-decoration: none;
    position: relative;
    overflow: hidden;
  }

  .github-cta-btn:hover {
    background: linear-gradient(180deg, #383b42 0%, #1a1b1f 100%);
    border-color: #636874;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.42), 0 8px 22px rgba(0, 0, 0, 0.2);
  }

  .btn-arrow {
    transition: transform var(--transition-smooth);
  }

  .github-cta-btn:hover .btn-arrow {
    transform: translate(2px, -2px);
  }

  /* Repo Window */
  .repo-window {
    background: linear-gradient(180deg, #ffffff 0%, #fafbfc 100%);
    border: 1px solid #d4d7df;
    border-radius: 8px;
    overflow: hidden;
    text-align: center;
    margin-top: var(--space-lg);
    box-shadow: inset 0 1px 0 #ffffff, 0 8px 30px rgba(15, 20, 30, 0.06);
    transition: border-color var(--transition-smooth), box-shadow var(--transition-smooth);
  }

  .repo-window:hover {
    border-color: #a8aebc;
    box-shadow: inset 0 1px 0 #ffffff, 0 14px 40px rgba(15, 20, 30, 0.09);
  }

  .window-header {
    background: linear-gradient(180deg, #fbfcfd 0%, #eaecee 100%);
    padding: 10px 16px;
    border-bottom: 1px solid #c9cdd6;
    display: flex;
    align-items: center;
    box-shadow: inset 0 1px 0 #ffffff;
  }

  .dots-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.5), 0 1px 2px rgba(0, 0, 0, 0.12);
  }

  .dot.red { background: #ff5f56; }
  .dot.yellow { background: #ffbd2e; }
  .dot.green { background: #27c93f; }

  .window-title {
    font-family: 'Fira Code', monospace;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-left: 8px;
  }

  .window-body {
    padding: var(--space-2xl) var(--space-lg);
  }

  .empty-repo-icon {
    font-size: 2.4rem;
    margin-bottom: var(--space-xs);
  }

  .status-code-tag {
    font-family: 'Fira Code', monospace;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .repo-window h3 {
    font-size: 1.5rem;
    margin-bottom: var(--space-xs);
    letter-spacing: 0.02em;
  }

  .repo-note {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
    max-width: 520px;
    margin: 0 auto var(--space-lg);
  }

  .view-profile-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 22px;
    background: linear-gradient(180deg, #ffffff 0%, #edf0f4 100%);
    border: 1px solid #ccd1da;
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 4px;
    box-shadow: inset 0 1px 0 #ffffff, 0 1px 3px rgba(0, 0, 0, 0.03);
    transition: all var(--transition-smooth);
  }

  .view-profile-btn:hover {
    background: linear-gradient(180deg, #ffffff 0%, #e2e5eb 100%);
    border-color: #8c93a0;
    color: #111111;
    transform: translateY(-2px);
    box-shadow: inset 0 1px 0 #ffffff, 0 4px 12px rgba(0, 0, 0, 0.08);
  }
</style>