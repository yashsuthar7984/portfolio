---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 | Page Not Found">
  
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "404 Error"
  }
  </script>

  <section class="error-section">
    <div class="terminal-window fade-in-up">
      <div class="terminal-header">
        <span class="dot red"></span>
        <span class="dot yellow"></span>
        <span class="dot green"></span>
        <span class="title">error_404.py</span>
      </div>
      <div class="terminal-body">
        <pre><code><span class="comment"># Exception Caught</span>
<span class="keyword">raise</span> <span class="class-name">FileNotFoundError</span>(<span class="string">"The requested URL was not found on this server."</span>)

<span class="comment"># Recommended action</span>
<span class="function">redirect_to</span>(<span class="string">"<a href='/' class='home-link'>/home</a>"</span>)</code></pre>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .error-section {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }
  .terminal-window {
    background: var(--color-surface);
    border-radius: 8px;
    box-shadow: 0 16px 40px rgba(0,0,0,0.06);
    width: 100%;
    max-width: 600px;
    border: 1px solid var(--color-border);
    overflow: hidden;
  }
  .terminal-header {
    background: var(--color-surface-elevated);
    padding: 12px 16px;
    display: flex;
    align-items: center;
    gap: 8px;
    border-bottom: 1px solid var(--color-border);
  }
  .dot { width: 12px; height: 12px; border-radius: 50%; }
  .red { background: #ff5f56; }
  .yellow { background: #ffbd2e; }
  .green { background: #27c93f; }
  .title { margin: 0 auto; color: var(--color-text-muted); font-family: 'Fira Code', monospace; font-size: 0.85rem; }
  .terminal-body {
    padding: 2rem;
    font-family: 'Fira Code', monospace;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text-primary);
  }
  
  .keyword { color: #0550ae; font-weight: 600; }
  .class-name { color: #953800; font-weight: 600; }
  .function { color: #8250df; }
  .string { color: #0a3069; }
  .comment { color: #5e646e; font-style: italic; }
  
  .home-link {
    color: #0550ae;
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: all 0.2s ease;
  }
  .home-link:hover {
    color: #111111;
  }
</style>