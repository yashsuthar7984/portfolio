---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 Not Found">
  <section style="padding: var(--space-xl) 0; text-align: center;">
    <h1 style="font-size: 6rem; color: var(--color-accent);">404</h1>
    <p style="color: var(--color-text-muted);">The requested page does not exist.</p>
    <a href="/" style="display: inline-block; margin-top: var(--space-md); padding: var(--space-sm) var(--space-md); border: var(--divider);">Return Home</a>
  </section>
</BaseLayout>
