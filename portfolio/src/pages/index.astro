  @media (max-width: 640px) {
    .hero-section {
      padding: 60px var(--space-md) var(--space-xl);
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .btn {
      width: 100%;
    }
    .rating-box {
      padding: var(--space-md);
    }
    .connect-buttons {
      flex-direction: column;
    }
    .stars-selector {
      gap: 6px;
    }
    .star-button {
      font-size: 1.9rem;
    }
    .bar-separator {
      display: none;
    }
    .metrics-bar {
      gap: var(--space-md);
    }
  }
</style>