---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home">
  <section class="hero">
    <div class="hero-content">
      <div class="reveal-mask">
        <span class="label">System.out.println("Hello, World!");</span>
      </div>
      <div class="reveal-mask">
        <h1 class="display-title">Yash Suthar</h1>
      </div>
      
      <div class="reveal-mask">
        <!-- Terminal Code Block Bio -->
        <div class="terminal-block">
          <div class="terminal-header">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
            <span class="file-name">developer.py</span>
          </div>
          <div class="terminal-body">
            <p class="code-text">
              <span class="keyword">class</span> <span class="class-name">Developer</span>:<br/>
              &nbsp;&nbsp;&nbsp;&nbsp;<span class="keyword">def</span> <span class="function">__init__</span>(<span class="variable">self</span>):<br/>
              &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="variable">self</span>.core_stack = [<span class="string">"Python"</span>, <span class="string">"Java"</span>]<br/>
              &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="variable">self</span>.hobbies = [<span class="string">"Cinematic Video Editing"</span>, <span class="string">"Content Creation"</span>]<br/>
              <br/>
              &nbsp;&nbsp;&nbsp;&nbsp;<span class="keyword">def</span> <span class="function">mission</span>(<span class="variable">self</span>):<br/>
              &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="keyword">return</span> <span class="string">"Writing clean, secure, and scalable systems."</span>
            </p>
          </div>
        </div>
      </div>

      <!-- Quick Action Buttons -->
      <div class="reveal-mask action-links">
        <a href="/work/code" class="action-btn primary">Explore Code ↗</a>
        <a href="/work/hobbies" class="action-btn secondary">Cinematic Video ↗</a>
        <a href="/about" class="action-btn outline">About & Reviews</a>
      </div>

    </div>
  </section>
</BaseLayout>

<!-- GSAP Animation Scripts -->
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    // Stagger the text and terminal sliding up
    gsap.from(".reveal-mask > *", {
      y: 80,
      opacity: 0,
      duration: 1.1,
      stagger: 0.15,
      ease: "power4.out",
      delay: 0.2
    });
  });
</script>

<style>
  /* Layout */
  .hero {
    position: relative;
    min-height: calc(100vh - 80px);
    display: flex;
    align-items: center;
    padding: 0 var(--space-lg);
    margin-top: -80px;
    overflow: hidden;
  }

  /* Content Styling */
  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
    padding-top: 10vh;
  }

  .reveal-mask {
    overflow: hidden;
  }

  .label {
    font-family: 'Fira Code', monospace;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    display: block;
    margin-bottom: var(--space-md);
  }

  .display-title {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(3.5rem, 10vw, 9rem);
    text-transform: uppercase;
    line-height: 0.95;
    margin-bottom: var(--space-md);
    letter-spacing: -0.02em;
  }

  /* Terminal Window UI */
  .terminal-block {
    background: rgba(17, 17, 17, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    max-width: 650px;
    margin-top: var(--space-lg);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(10px);
  }

  .terminal-header {
    background: rgba(26, 26, 26, 0.9);
    padding: 12px 15px;
    display: flex;
    align-items: center;
    gap: 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
  }

  .dot { width: 12px; height: 12px; border-radius: 50%; }
  .dot.red { background: #ff5f56; }
  .dot.yellow { background: #ffbd2e; }
  .dot.green { background: #27c93f; }
  
  .file-name {
    margin-left: auto;
    margin-right: auto;
    font-family: 'Fira Code', monospace;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .terminal-body {
    padding: var(--space-lg);
    overflow-x: auto;
  }

  /* Code Syntax Highlighting */
  .code-text {
    font-family: 'Fira Code', monospace;
    font-size: clamp(0.85rem, 1.5vw, 1rem);
    line-height: 1.7;
    margin: 0;
    color: #abb2bf;
  }
  .keyword { color: #c678dd; }
  .class-name { color: #e5c07b; }
  .function { color: #61afef; }
  .variable { color: #e06c75; }
  .string { color: #98c379; }

  /* Action Links */
  .action-links {
    display: flex;
    gap: var(--space-md);
    margin-top: var(--space-xl);
    flex-wrap: wrap;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    padding: 10px 22px;
    border-radius: 4px;
    font-family: var(--font-display);
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all var(--transition-smooth);
  }

  .action-btn.primary {
    background: var(--color-accent);
    color: #ffffff;
    border: 1px solid transparent;
  }

  .action-btn.primary:hover {
    background: #d60000;
    box-shadow: 0 4px 18px rgba(179, 0, 0, 0.4);
    transform: translateY(-2px);
  }

  .action-btn.secondary {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--color-text-primary);
  }

  .action-btn.secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-2px);
  }

  .action-btn.outline {
    background: transparent;
    border: 1px solid var(--divider);
    color: var(--color-text-muted);
  }

  .action-btn.outline:hover {
    color: var(--color-text-primary);
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-2px);
  }

  @media (max-width: 640px) {
    .hero {
      padding: 0 var(--space-md);
    }
    .action-links {
      flex-direction: column;
      align-items: stretch;
    }
    .action-btn {
      justify-content: center;
    }
  }
</style>