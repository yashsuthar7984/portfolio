---
import BaseLayout from '../layouts/BaseLayout.astro';
import { reviews } from '../data/reviews.js';


function getCategoryInfo(type: string) {
  const t = (type || '').toLowerCase();
  if (t.includes('shoot')) {
    return { key: 'shoots', label: 'Shoots' };
  }
  if (t.includes('auto') || t.includes('car')) {
    return { key: 'automotive', label: 'Automotive' };
  }
  if (t.includes('edit')) {
    return { key: 'editing', label: 'Editing' };
  }
  return { key: 'tech', label: 'Tech' };
}
---

<BaseLayout 
  title="About & Reviews"
  description="About Yash Suthar - Software developer specializing in Python and Java, video content creator, and client reviews."
>
  <section class="about-page">
    <div class="content-container">

      <!-- Page Header -->
      <header class="page-header fade-in">
        <h1 class="main-title">About &amp; Reviews</h1>
        <p class="main-subtitle">
          Software engineering systems and video content creation — backed by verified client feedback.
        </p>
      </header>

      <!-- Top Section: profile.md and certificate side by side -->
      <div class="profile-cert-grid fade-in" id="certificate">
        <!-- 1. Bio / Profile Card (profile.md) -->
        <div class="bio-card">
          <div class="window-header">
            <div class="dots-row">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
              <span class="window-tag">profile.md</span>
            </div>
            <span class="cert-status-pill">&#9679; Active</span>
          </div>
          <div class="bio-body">
            <p class="bio-text">
              I am a software developer focused on building robust, scalable systems using <strong>Python</strong> and <strong>Java</strong>. I enjoy tackling complex architectural problems, engineering resilient backend services, and writing clean, secure code that performs under load.
            </p>
            <p class="bio-text">
              When I step away from the IDE, I spend my time video editing and creating content (<strong>@framed.by.yash</strong>). I am actively learning the craft of video editing, experimenting with visual cuts and audio as a creative outlet.
            </p>
            
            <div class="skills-row">
              <span class="skill-pill">Python</span>
              <span class="skill-pill">Java</span>
              <span class="skill-pill">Backend Architecture</span>
              <span class="skill-pill">API Security</span>
              <span class="skill-pill">Video Editing</span>
              <span class="skill-pill">Content Creation</span>
            </div>
          </div>
        </div>

        <!-- 2. Certificate Card (certificate.md) -->
        <div class="cert-card">
          <div class="window-header">
            <div class="dots-row">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
              <span class="window-tag">certificate.md</span>
            </div>
            <span class="cert-status-pill">&#10003; Verified</span>
          </div>

          <div class="cert-body">
            <div class="cert-frame-wrapper">
              <div class="cert-frame" id="openCertModal" role="button" tabindex="0" title="Click to view full certificate">
                <img 
                  src="/certificates/technishal-genai.jpg" 
                  alt="GenAI with Python Certificate - Yash Suthar" 
                  class="certificate-image" 
                  id="certImage"
                />
                <div class="frame-hover-hint">
                  <span>View Full Photo &rarr;</span>
                </div>
              </div>
            </div>

            <div class="cert-details">
              <div class="cert-title-row">
                <h3 class="cert-title">GenAI with Python</h3>
                <span class="cert-badge">Course Completed</span>
              </div>
              <p class="cert-desc">
                Coursework covering principles of generative models, foundational Python, and prompt techniques.
              </p>

              <div class="cert-topics-card">
                <h4 class="topics-heading">Course Highlights</h4>
                <ul class="topics-list">
                  <li><strong>GenAI Principles:</strong> Model workflows &amp; architecture</li>
                  <li><strong>Python Scripting:</strong> Data handling &amp; core logic</li>
                  <li><strong>Prompt Techniques:</strong> Context structuring &amp; AI integration</li>
                </ul>
              </div>

              <button type="button" class="submit-action-btn view-cert-btn" id="viewCertButton">
                <span>View Full Certificate Photo</span>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Reviews Section -->
      <section class="reviews-section fade-in" id="reviews">
        <div class="section-heading">
          <h2 class="sub-title">Client Reviews</h2>
          <p class="sub-desc">
            Direct feedback from teams, founders, and creators on tech and video editing projects.
          </p>
        </div>

        <!-- Controls Bar: Segment Dropdown, Rating Dropdown, and Write Review Toggle -->
        <div class="reviews-controls-bar">
          <div class="filter-controls-group">
            <div class="filter-item">
              <label for="categoryFilter" class="filter-label">Segment</label>
              <select id="categoryFilter" class="filter-dropdown" aria-label="Filter reviews by segment">
                <option value="all">All Segments</option>
                <option value="tech">Tech</option>
                <option value="editing">Editing</option>
                <option value="automotive">Automotive</option>
                <option value="shoots">Shoots</option>
              </select>
            </div>

            <div class="filter-item">
              <label for="ratingFilter" class="filter-label">Rating</label>
              <select id="ratingFilter" class="filter-dropdown" aria-label="Filter reviews by rating">
                <option value="all">All Ratings</option>
                <option value="5">5 ★★★★★</option>
                <option value="4">4 ★★★★</option>
                <option value="3">3 ★★★</option>
                <option value="2">2 ★★</option>
                <option value="1">1 ★</option>
              </select>
            </div>
          </div>

          <button type="button" id="toggleReviewFormBtn" class="toggle-form-btn" aria-expanded="false" aria-controls="review-form">
            <span class="btn-toggle-icon" id="toggleFormIcon">+</span>
            <span id="toggleFormLabel">Write a Review</span>
          </button>
        </div>

        <!-- Published Reviews (Live from Google Sheets + Pre-rendered Fallback) -->
        <div id="reviewsContainer" class="reviews-container">
          <div class="reviews-grid" id="reviewsGrid" style={reviews.length > 0 ? "" : "display: none;"}>
            {reviews.map((rev) => {
              const info = getCategoryInfo(rev.projectType);
              const starCount = rev.rating || 5;

              return (
                <article 
                  class={`review-card card-${info.key}`}
                  data-category={info.key}
                  data-rating={starCount}
                >
                  <div class="card-header">
                    <div class="client-rating-group">
                      <h3 class="client-name">{rev.clientName}</h3>
                      <div class="stars-gold" aria-label={`${starCount} out of 5 stars`}>
                        {Array.from({ length: starCount }).map(() => (
                          <span class="star-char">&#9733;</span>
                        ))}
                      </div>
                    </div>
                    <span class={`type-badge type-${info.key}`}>
                      {info.label}
                    </span>
                  </div>

                  <div class="quote-container">
                    <p class="review-quote">
                      &ldquo;{rev.comment}&rdquo;
                    </p>
                  </div>
                </article>
              );
            })}
          </div>

          <div class="filter-no-results" id="filterNoResults" style="display: none;">
            <p>No reviews match the selected segment and rating.</p>
            <button type="button" id="resetFiltersBtn" class="reset-filter-btn">Reset Filters</button>
          </div>

          <div class="empty-reviews-state" id="emptyReviewsState" style={reviews.length > 0 ? "display: none;" : ""}>
            <div class="empty-star-badge">&#9733;</div>
            <h3>No Reviews Published Yet</h3>
            <p>
              Have we collaborated on a tech or video editing project? 
              Share your feedback below to be the first client featured on this page!
            </p>
            <button type="button" class="scroll-btn" id="emptyStateLeaveBtn">
              Leave a Review &darr;
            </button>
          </div>
        </div>

        <!-- Terminal Form to Submit a Review (Collapsible) -->
        <div class="review-form-window" id="review-form" style="display: none;">
          <div class="window-header">
            <div class="dots-row">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
              <span class="window-title">leave_review.sh</span>
            </div>
          </div>

          <div class="window-content">
            <h3>Leave a Review</h3>
            <p class="form-help">
              Collaborated on software engineering or cinematic video editing? Submit your review below.
            </p>

            <form id="reviewSubmissionForm" class="styled-review-form">
              <!-- 1. Client Name -->
              <div class="form-group">
                <label for="clientName">Client Name *</label>
                <input 
                  type="text" 
                  id="clientName" 
                  name="client_name" 
                  placeholder="Your Full Name (e.g. Alex Morgan)" 
                  required 
                />
              </div>

              <!-- 2. Project Type / Segment -->
              <div class="form-group">
                <label for="projectType">Segment *</label>
                <select id="projectType" name="project_type" required>
                  <option value="" disabled selected>Select segment...</option>
                  <option value="Editing">Editing</option>
                  <option value="Automotive">Automotive</option>
                  <option value="Tech">Tech</option>
                  <option value="Shoots">Shoots</option>
                </select>
              </div>

              <!-- 3. Interactive Clickable Stars System -->
              <div class="form-group">
                <label>Stars Rating (Click to Rate) *</label>
                <div class="interactive-star-rating" id="interactiveStarRating" role="radiogroup" aria-label="Select star rating">
                  <button type="button" class="star-click-btn active" data-value="1" title="1 Star - Poor" aria-label="1 star">&#9733;</button>
                  <button type="button" class="star-click-btn active" data-value="2" title="2 Stars - Fair" aria-label="2 stars">&#9733;</button>
                  <button type="button" class="star-click-btn active" data-value="3" title="3 Stars - Good" aria-label="3 stars">&#9733;</button>
                  <button type="button" class="star-click-btn active" data-value="4" title="4 Stars - Very Good" aria-label="4 stars">&#9733;</button>
                  <button type="button" class="star-click-btn active" data-value="5" title="5 Stars - Exceptional" aria-label="5 stars">&#9733;</button>
                  <span class="rating-text-feedback" id="ratingTextFeedback">5 / 5 Stars (Exceptional)</span>
                </div>
                <input type="hidden" id="starRatingHidden" name="stars_rating" value="5" required />
              </div>

              <!-- 4. Written Review Text -->
              <div class="form-group">
                <label for="reviewMessage">Write Your Review *</label>
                <textarea 
                  id="reviewMessage" 
                  name="review_text" 
                  rows="4" 
                  placeholder="Write your review regarding project deliverables, communication, turnaround speed, code quality, or editing style..." 
                  required
                ></textarea>
              </div>

              <div id="reviewStatus" class="form-status" style="display: none;"></div>

              <button type="submit" id="reviewSubmitBtn" class="submit-action-btn">
                <span id="reviewBtnText">Submit Review</span>
                <span class="btn-arrow">&rarr;</span>
              </button>
            </form>
          </div>
        </div>

      </section>

    </div>
  </section>

  <!-- LIGHTBOX / FULLSCREEN CERTIFICATE MODAL -->
  <div class="cert-modal" id="certModal" aria-hidden="true" role="dialog" aria-label="Certificate Image Viewer">
    <div class="cert-modal-backdrop" id="modalBackdrop"></div>
    <div class="cert-modal-window">
      <div class="modal-header">
        <span class="modal-title">GenAI with Python Certificate</span>
        <button type="button" class="modal-close-btn" id="modalCloseBtn" aria-label="Close modal">&times;</button>
      </div>
      <div class="modal-body">
        <img 
          src="/certificates/technishal-genai.jpg" 
          alt="GenAI with Python Certificate" 
          class="modal-cert-img" 
          id="modalCertImg"
        />
      </div>
      <div class="modal-footer">
        <span class="modal-cert-caption">Certificate: Yash Suthar &bull; GenAI with Python</span>
        <button type="button" class="modal-close-btn-text" id="modalCloseSecondary">Close</button>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    // Certificate Image Fallback
    const placeholderSvg = "/certificates/certificate-placeholder.svg";
    const certImage = document.getElementById("certImage");
    const modalCertImg = document.getElementById("modalCertImg");

    function attachImgFallback(imgEl) {
      if (!imgEl) return;
      imgEl.addEventListener("error", () => {
        imgEl.src = placeholderSvg;
      });
      if (imgEl.complete && (imgEl.naturalWidth === 0 || imgEl.naturalHeight === 0)) {
        imgEl.src = placeholderSvg;
      }
    }
    attachImgFallback(certImage);
    attachImgFallback(modalCertImg);

    // Modal Controls
    const modal = document.getElementById("certModal");
    const openTrigger1 = document.getElementById("openCertModal");
    const openTrigger2 = document.getElementById("viewCertButton");
    const closeBtn = document.getElementById("modalCloseBtn");
    const closeSecondary = document.getElementById("modalCloseSecondary");
    const backdrop = document.getElementById("modalBackdrop");

    function openModal() {
      if (!modal) return;
      modal.classList.add("active");
      modal.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.remove("active");
      modal.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }

    if (openTrigger1) openTrigger1.addEventListener("click", openModal);
    if (openTrigger2) openTrigger2.addEventListener("click", openModal);
    if (closeBtn) closeBtn.addEventListener("click", closeModal);
    if (closeSecondary) closeSecondary.addEventListener("click", closeModal);
    if (backdrop) backdrop.addEventListener("click", closeModal);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal && modal.classList.contains("active")) {
        closeModal();
      }
    });

    // Star rating form in About page
    const starContainer = document.getElementById("interactiveStarRating");
    if (!starContainer) return;

    const stars = starContainer.querySelectorAll(".star-click-btn");
    const hiddenInput = document.getElementById("starRatingHidden");
    const feedbackText = document.getElementById("ratingTextFeedback");

    const labels = {
      1: "1 / 5 Stars (Poor)",
      2: "2 / 5 Stars (Fair)",
      3: "3 / 5 Stars (Good)",
      4: "4 / 5 Stars (Very Good)",
      5: "5 / 5 Stars (Exceptional)"
    };

    let selectedRating = 5;

    function updateStarsDisplay(rating, isHovering) {
      stars.forEach((star) => {
        const val = parseInt(star.getAttribute("data-value"), 10);
        if (isHovering) {
          if (val <= rating) {
            star.classList.add("hover-active");
          } else {
            star.classList.remove("hover-active");
            star.classList.remove("active");
          }
        } else {
          star.classList.remove("hover-active");
          if (val <= rating) {
            star.classList.add("active");
          } else {
            star.classList.remove("active");
          }
        }
      });

      if (feedbackText && labels[rating]) {
        feedbackText.textContent = labels[rating];
      }
    }

    stars.forEach((star) => {
      // Click to choose rating
      star.addEventListener("click", () => {
        selectedRating = parseInt(star.getAttribute("data-value"), 10);
        if (hiddenInput) {
          hiddenInput.value = selectedRating;
        }
        updateStarsDisplay(selectedRating, false);
      });

      // Hover to preview
      star.addEventListener("mouseenter", () => {
        const hoverVal = parseInt(star.getAttribute("data-value"), 10);
        updateStarsDisplay(hoverVal, true);
      });
    });

    // Reset when mouse leaves star container
    starContainer.addEventListener("mouseleave", () => {
      updateStarsDisplay(selectedRating, false);
    });

    // Helper to safely escape user inputs
    function escapeHTML(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function getCategoryInfo(type) {
      const t = (type || '').toLowerCase();
      if (t.includes('shoot')) {
        return { key: 'shoots', label: 'Shoots' };
      }
      if (t.includes('auto') || t.includes('car')) {
        return { key: 'automotive', label: 'Automotive' };
      }
      if (t.includes('edit')) {
        return { key: 'editing', label: 'Editing' };
      }
      return { key: 'tech', label: 'Tech' };
    }

    function createReviewCardHTML(rev) {
      const info = getCategoryInfo(rev.projectType);
      const name = rev.clientName || 'Anonymous';
      const rating = Number(rev.rating) || 5;
      const starsHtml = Array.from({ length: Math.min(Math.max(rating, 1), 5) })
        .map(() => '<span class="star-char">&#9733;</span>')
        .join('');

      return `
        <article 
          class="review-card card-${info.key}" 
          data-category="${info.key}" 
          data-rating="${rating}"
        >
          <div class="card-header">
            <div class="client-rating-group">
              <h3 class="client-name">${escapeHTML(name)}</h3>
              <div class="stars-gold" aria-label="${rating} out of 5 stars">${starsHtml}</div>
            </div>
            <span class="type-badge type-${info.key}">${escapeHTML(info.label)}</span>
          </div>

          <div class="quote-container">
            <p class="review-quote">
              &ldquo;${escapeHTML(rev.comment)}&rdquo;
            </p>
          </div>
        </article>
      `;
    }

    const reviewsGrid = document.getElementById("reviewsGrid");
    const emptyState = document.getElementById("emptyReviewsState");
    const reviewsEndpoint = "https://script.google.com/macros/s/AKfycby04ELFZtQYqk2jRt6Tr5sOlijQ9GgEvhJssfV9_Txxa39sS3R49MpShwCBQnwd46pZ/exec";
    const STORAGE_KEY = "portfolio_saved_reviews_v1";

    // Filter Controls
    const categoryFilter = document.getElementById("categoryFilter");
    const ratingFilter = document.getElementById("ratingFilter");
    const filterNoResults = document.getElementById("filterNoResults");
    const resetFiltersBtn = document.getElementById("resetFiltersBtn");

    function applyFilters() {
      const selectedCat = categoryFilter ? categoryFilter.value : "all";
      const selectedRating = ratingFilter ? ratingFilter.value : "all";

      const cards = reviewsGrid ? reviewsGrid.querySelectorAll(".review-card") : [];
      let visibleCount = 0;

      cards.forEach((card) => {
        const cat = card.getAttribute("data-category") || "";
        const rating = card.getAttribute("data-rating") || "";

        const matchCat = (selectedCat === "all" || cat === selectedCat);
        const matchRating = (selectedRating === "all" || String(rating) === String(selectedRating));

        if (matchCat && matchRating) {
          card.style.display = "flex";
          visibleCount++;
        } else {
          card.style.display = "none";
        }
      });

      if (filterNoResults) {
        if (visibleCount === 0 && cards.length > 0) {
          filterNoResults.style.display = "block";
        } else {
          filterNoResults.style.display = "none";
        }
      }
    }

    if (categoryFilter) categoryFilter.addEventListener("change", applyFilters);
    if (ratingFilter) ratingFilter.addEventListener("change", applyFilters);
    if (resetFiltersBtn) {
      resetFiltersBtn.addEventListener("click", () => {
        if (categoryFilter) categoryFilter.value = "all";
        if (ratingFilter) ratingFilter.value = "all";
        applyFilters();
      });
    }

    // Toggle Review Submission Form
    const toggleFormBtn = document.getElementById("toggleReviewFormBtn");
    const reviewFormWindow = document.getElementById("review-form");
    const toggleFormIcon = document.getElementById("toggleFormIcon");
    const toggleFormLabel = document.getElementById("toggleFormLabel");
    const emptyStateLeaveBtn = document.getElementById("emptyStateLeaveBtn");

    function openReviewForm() {
      if (!reviewFormWindow) return;
      reviewFormWindow.style.display = "block";
      if (toggleFormIcon) toggleFormIcon.innerHTML = "&times;";
      if (toggleFormLabel) toggleFormLabel.textContent = "Close Form";
      if (toggleFormBtn) toggleFormBtn.setAttribute("aria-expanded", "true");
    }

    function closeReviewForm() {
      if (!reviewFormWindow) return;
      reviewFormWindow.style.display = "none";
      if (toggleFormIcon) toggleFormIcon.textContent = "+";
      if (toggleFormLabel) toggleFormLabel.textContent = "Write a Review";
      if (toggleFormBtn) toggleFormBtn.setAttribute("aria-expanded", "false");
    }

    if (toggleFormBtn && reviewFormWindow) {
      toggleFormBtn.addEventListener("click", () => {
        if (reviewFormWindow.style.display === "none") {
          openReviewForm();
          reviewFormWindow.scrollIntoView({ behavior: "smooth", block: "start" });
        } else {
          closeReviewForm();
        }
      });
    }

    if (emptyStateLeaveBtn) {
      emptyStateLeaveBtn.addEventListener("click", () => {
        openReviewForm();
        reviewFormWindow?.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    }

    if (window.location.hash === "#review-form") {
      openReviewForm();
    }

    function getStoredReviews() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        return raw ? JSON.parse(raw) : [];
      } catch (e) {
        return [];
      }
    }

    function saveReviewLocally(rev) {
      try {
        const list = getStoredReviews();
        // Avoid adding duplicate comments
        if (!list.some(r => r.comment === rev.comment && r.clientName === rev.clientName)) {
          list.unshift(rev);
          localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
        }
      } catch (e) {}
    }

    // Render any locally submitted reviews so they persist on refresh
    function renderLocalReviews() {
      const stored = getStoredReviews();
      if (stored.length > 0 && reviewsGrid) {
        const existingComments = new Set(
          Array.from(reviewsGrid.querySelectorAll('.review-quote')).map(el => el.textContent.trim().replace(/^“|”$/g, ''))
        );
        stored.forEach(r => {
          if (!existingComments.has((r.comment || '').trim())) {
            reviewsGrid.insertAdjacentHTML('afterbegin', createReviewCardHTML(r));
            existingComments.add((r.comment || '').trim());
          }
        });
        reviewsGrid.style.display = 'grid';
        if (emptyState) emptyState.style.display = 'none';
        applyFilters();
      }
    }
    renderLocalReviews();

    async function loadReviewsFromSheet() {
      try {
        const res = await fetch(reviewsEndpoint);
        if (!res.ok) return;
        const data = await res.json();
        if (Array.isArray(data) && data.length > 0 && reviewsGrid) {
          const existingComments = new Set(
            Array.from(reviewsGrid.querySelectorAll('.review-quote')).map(el => el.textContent.trim().replace(/^“|”$/g, ''))
          );
          data.forEach(r => {
            if (!existingComments.has((r.comment || '').trim())) {
              reviewsGrid.insertAdjacentHTML('beforeend', createReviewCardHTML(r));
              existingComments.add((r.comment || '').trim());
            }
          });
          reviewsGrid.style.display = 'grid';
          if (emptyState) emptyState.style.display = 'none';
          applyFilters();
        }
      } catch (e) {
        console.warn('Could not load live reviews from sheet:', e);
      }
    }

    loadReviewsFromSheet();

    // Review form async submission to Google Apps Script
    const reviewForm = document.getElementById("reviewSubmissionForm");
    const reviewStatus = document.getElementById("reviewStatus");
    const reviewSubmitBtn = document.getElementById("reviewSubmitBtn");
    const reviewBtnText = document.getElementById("reviewBtnText");

    if (reviewForm && reviewStatus && reviewSubmitBtn && reviewBtnText) {
      reviewForm.addEventListener("submit", async (e) => {
        e.preventDefault();

        reviewSubmitBtn.setAttribute("disabled", "true");
        reviewBtnText.textContent = "Submitting Review...";
        reviewStatus.style.display = "none";
        reviewStatus.className = "form-status";

        const formData = new FormData(reviewForm);
        const payload = {
          client_name: formData.get("client_name"),
          project_type: formData.get("project_type"),
          stars_rating: formData.get("stars_rating") || "5",
          review_text: formData.get("review_text")
        };

        try {
          await fetch(reviewsEndpoint, {
            method: "POST",
            mode: "no-cors",
            headers: {
              "Content-Type": "text/plain;charset=utf-8"
            },
            body: JSON.stringify(payload)
          });

          reviewStatus.className = "form-status success";
          reviewStatus.innerHTML = "&#10003; <strong>Review Submitted!</strong> Thank you for your feedback. Your review has been recorded in the database.";
          reviewStatus.style.display = "block";

          const newRevObj = {
            clientName: payload.client_name,
            projectType: payload.project_type,
            rating: payload.stars_rating,
            comment: payload.review_text
          };

          // Save to localStorage so it stays permanent on refresh
          saveReviewLocally(newRevObj);

          // Instantly show the submitted review on the page
          if (reviewsGrid) {
            const newCardHtml = createReviewCardHTML(newRevObj);
            reviewsGrid.insertAdjacentHTML('afterbegin', newCardHtml);
            reviewsGrid.style.display = 'grid';
            applyFilters();
          }
          if (emptyState) {
            emptyState.style.display = 'none';
          }

          reviewForm.reset();
          selectedRating = 5;
          updateStarsDisplay(5, false);
        } catch (err) {
          reviewStatus.className = "form-status error";
          reviewStatus.innerHTML = "&#9888; Something went wrong while submitting. Please try again or reach out directly.";
          reviewStatus.style.display = "block";
        } finally {
          reviewSubmitBtn.removeAttribute("disabled");
          reviewBtnText.textContent = "Submit Review";
        }
      });
    }

    // Initial render
    updateStarsDisplay(5, false);
  });
</script>

