---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Contact"
  description="Reach out to Yash Suthar for software engineering contracts, creative collaborations, or general inquiries."
>
  <section class="contact-section">
    <div class="content-wrapper">
      
      <!-- Section Header -->
      <header class="section-header fade-in">
        <div class="badge-row">
          <span class="terminal-badge">
            <span class="status-dot"></span>
            <code>// CONNECT // INQUIRIES</code>
          </span>
        </div>
        <h1 class="title">Contact</h1>
        <p class="description">
          Reach out for software contracts, creative collaborations, or general inquiries.
        </p>
      </header>

      <!-- Direct Contact Details -->
      <div class="contact-details fade-in">
        <span class="details-label">DIRECT INQUIRIES</span>
        <h3>Yash Suthar</h3>
        <a href="mailto:yashsuthar7984@gmail.com" class="email-link">
          yashsuthar7984@gmail.com
        </a>
      </div>
      
      <!-- Secure Contact Form Window -->
      <div class="contact-form-window fade-in">
        <div class="window-header">
          <div class="dots-row">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
            <span class="window-title">contact_form.sh</span>
          </div>
        </div>

        <div class="window-body">
          <form action="https://formsubmit.co/yashsuthar7984@gmail.com" method="POST" class="contact-form">
            <div class="form-group">
              <label for="name">Your Name *</label>
              <input type="text" id="name" name="name" placeholder="Alex Morgan" required />
            </div>

            <div class="form-group">
              <label for="email">Your Email *</label>
              <input type="email" id="email" name="email" placeholder="alex@example.com" required />
            </div>

            <div class="form-group">
              <label for="message">Your Message *</label>
              <textarea id="message" name="message" placeholder="Describe your project, timeline, or inquiry..." rows="5" required></textarea>
            </div>
            
            <!-- FormSubmit configuration -->
            <input type="hidden" name="_subject" value="New submission from your portfolio!" />
            <input type="hidden" name="_autoresponse" value="Thank you for reaching out! We will get back to you in 1-2 business days." />
            
            <button type="submit" class="submit-btn">
              <span>Send Message</span>
              <span class="arrow">&rarr;</span>
            </button>
          </form>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  .contact-section {
    padding: var(--space-2xl) var(--space-md);
    display: flex;
    justify-content: center;
    min-height: 80vh;
  }
  
  .content-wrapper {
    max-width: 640px;
    width: 100%;
    margin: 0 auto;
    text-align: center;
  }

  .section-header {
    margin-bottom: var(--space-xl);
  }

  .badge-row {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-xs);
  }

  .terminal-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 14px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    font-family: 'Fira Code', monospace;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .status-dot {
    width: 7px;
    height: 7px;
    background-color: var(--color-accent);
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(179, 0, 0, 0.7);
  }

  .title {
    font-size: clamp(3rem, 6vw, 4.8rem);
    margin-bottom: var(--space-xs);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .description {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: var(--space-lg);
  }

  /* Direct Contact Details Styling */
  .contact-details {
    margin-bottom: var(--space-xl);
    padding: var(--space-lg);
    background: rgba(18, 18, 18, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    backdrop-filter: blur(10px);
  }

  .details-label {
    display: block;
    font-family: 'Fira Code', monospace;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
    margin-bottom: 4px;
  }

  .contact-details h3 {
    margin-bottom: var(--space-xs);
    font-size: 1.4rem;
    letter-spacing: 0.05em;
  }

  .email-link {
    color: var(--color-accent);
    font-family: var(--font-text);
    font-size: 1.1rem;
    transition: opacity var(--transition-smooth);
    display: inline-block;
  }

  .email-link:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  /* Form Window */
  .contact-form-window {
    background: #0f0f0f;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    text-align: left;
  }

  .window-header {
    background: #181818;
    padding: 10px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .dots-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot.red { background: #ff5f56; }
  .dot.yellow { background: #ffbd2e; }
  .dot.green { background: #27c93f; }

  .window-title {
    font-family: 'Fira Code', monospace;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-left: 8px;
  }

  .window-body {
    padding: var(--space-lg);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font-family: 'Fira Code', monospace;
    font-size: 0.8rem;
    color: var(--color-text-primary);
  }

  .contact-form input,
  .contact-form textarea {
    padding: 12px 14px;
    background: var(--color-surface);
    border: var(--divider);
    color: var(--color-text-primary);
    font-family: var(--font-text);
    font-size: 0.95rem;
    border-radius: 4px;
    width: 100%;
    transition: border-color var(--transition-smooth), background var(--transition-smooth);
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    background: #181818;
  }

  .submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px;
    background: var(--color-accent);
    color: white;
    border: none;
    cursor: pointer;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 1rem;
    letter-spacing: 0.05em;
    border-radius: 4px;
    transition: all var(--transition-smooth);
    margin-top: var(--space-xs);
  }

  .submit-btn:hover {
    background: #d60000;
    box-shadow: 0 4px 18px rgba(179, 0, 0, 0.35);
    transform: translateY(-2px);
  }

  .arrow {
    transition: transform var(--transition-smooth);
  }

  .submit-btn:hover .arrow {
    transform: translateX(4px);
  }
</style>