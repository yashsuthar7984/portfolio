---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Contact"
  description="Reach out to Yash Suthar for software engineering contracts, creative collaborations, or general inquiries."
>
  <section class="contact-section">
    <div class="content-wrapper">
      
      <!-- Section Header -->
      <header class="section-header fade-in">
        <h1 class="title">Contact</h1>
        <p class="description">
          Reach out for software contracts, creative collaborations, or general inquiries.
        </p>
      </header>

      <!-- Direct Contact Details -->
      <div class="contact-details fade-in">
        <span class="details-label">DIRECT INQUIRIES</span>
        <h3>Yash Suthar</h3>
        <a href="mailto:yashsuthar7984@gmail.com" class="email-link">
          yashsuthar7984@gmail.com
        </a>
      </div>
      
      <!-- Secure Contact Form Window -->
      <div class="contact-form-window fade-in">
        <div class="window-header">
          <div class="dots-row">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
            <span class="window-title">contact_form.sh</span>
          </div>
        </div>

        <div class="window-body">
          <form id="contactForm" class="contact-form">
            <!-- Web3Forms Access Key & Config -->
            <input type="hidden" name="access_key" value="906f76f1-511d-4896-99a5-6169a6c1e8bd" />
            <input type="hidden" name="subject" value="New Contact Message from Yash Suthar Portfolio" />
            <input type="hidden" name="from_name" value="Yash Portfolio Contact Form" />
            <input type="checkbox" name="botcheck" style="display: none;" tabindex="-1" autocomplete="off" />

            <div class="form-group">
              <label for="name">Your Name *</label>
              <input type="text" id="name" name="name" placeholder="Alex Morgan" required />
            </div>

            <div class="form-group">
              <label for="email">Your Email *</label>
              <input type="email" id="email" name="email" placeholder="alex@example.com" required />
            </div>

            <div class="form-group">
              <label for="message">Your Message *</label>
              <textarea id="message" name="message" placeholder="Describe your project, timeline, or inquiry..." rows="5" required></textarea>
            </div>

            <div id="formStatus" class="form-status" style="display: none;"></div>

            <button type="submit" id="submitBtn" class="submit-btn">
              <span id="btnText">Send Message</span>
              <span class="arrow">&rarr;</span>
            </button>
          </form>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  const statusDiv = document.getElementById('formStatus') as HTMLDivElement | null;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;
  const btnText = document.getElementById('btnText') as HTMLSpanElement | null;

  if (form && statusDiv && submitBtn && btnText) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Loading state
      submitBtn.setAttribute('disabled', 'true');
      btnText.textContent = 'Sending...';
      statusDiv.style.display = 'none';
      statusDiv.className = 'form-status';

      const formData = new FormData(form);

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData
        });

        const data = await response.json();

        if (response.status === 200 && data.success) {
          statusDiv.className = 'form-status success';
          statusDiv.innerHTML = '&#10003; <strong>Message Sent Successfully!</strong> Thank you for reaching out &mdash; Yash will get back to you shortly.';
          statusDiv.style.display = 'block';
          form.reset();
        } else {
          statusDiv.className = 'form-status error';
          statusDiv.innerHTML = `&#9888; ${data.message || 'Submission failed. Please email yashsuthar7984@gmail.com directly.'}`;
          statusDiv.style.display = 'block';
        }
      } catch (err) {
        statusDiv.className = 'form-status error';
        statusDiv.innerHTML = '&#9888; Network error. Please reach out directly to yashsuthar7984@gmail.com';
        statusDiv.style.display = 'block';
      } finally {
        submitBtn.removeAttribute('disabled');
        btnText.textContent = 'Send Message';
      }
    });
  }
</script>

<style>
  .contact-section {
    padding: var(--space-2xl) var(--space-md);
    display: flex;
    justify-content: center;
    min-height: 80vh;
  }
  
  .content-wrapper {
    max-width: 640px;
    width: 100%;
    margin: 0 auto;
    text-align: center;
  }

  .section-header {
    margin-bottom: var(--space-xl);
  }

  .badge-row {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-xs);
  }

  .terminal-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 14px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    font-family: 'Fira Code', monospace;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .status-dot {
    width: 7px;
    height: 7px;
    background-color: var(--color-accent);
    border-radius: 50%;
  }

  .title {
    font-size: clamp(3rem, 6vw, 4.8rem);
    margin-bottom: var(--space-xs);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .description {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: var(--space-lg);
  }

  /* Direct Contact Details Styling */
  .contact-details {
    margin-bottom: var(--space-xl);
    padding: var(--space-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    transition: border-color var(--transition-smooth);
  }

  .contact-details:hover {
    border-color: var(--color-border-hover);
  }

  .details-label {
    display: block;
    font-family: 'Fira Code', monospace;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    letter-spacing: 0.08em;
    margin-bottom: 4px;
  }

  .contact-details h3 {
    margin-bottom: var(--space-xs);
    font-size: 1.4rem;
    letter-spacing: 0.05em;
    color: var(--color-text-primary);
  }

  .email-link {
    color: var(--color-text-primary);
    font-family: var(--font-text);
    font-size: 1.1rem;
    transition: opacity var(--transition-smooth);
    display: inline-block;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .email-link:hover {
    opacity: 0.8;
  }

  /* Form Window */
  .contact-form-window {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    text-align: left;
    transition: border-color var(--transition-smooth);
  }

  .contact-form-window:hover {
    border-color: var(--color-border-hover);
  }

  .window-header {
    background: var(--color-surface-elevated);
    padding: 10px 16px;
    border-bottom: 1px solid var(--color-border);
  }

  .dots-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot.red { background: #ff5f56; }
  .dot.yellow { background: #ffbd2e; }
  .dot.green { background: #27c93f; }

  .window-title {
    font-family: 'Fira Code', monospace;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-left: 8px;
  }

  .window-body {
    padding: var(--space-lg);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font-family: 'Fira Code', monospace;
    font-size: 0.8rem;
    color: var(--color-text-primary);
  }

  .contact-form input,
  .contact-form textarea {
    padding: 12px 14px;
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
    font-family: var(--font-text);
    font-size: 0.95rem;
    border-radius: 0;
    width: 100%;
    transition: border-color var(--transition-smooth), background var(--transition-smooth);
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: none;
    border-color: #111111;
    background: #ffffff;
  }

  .submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px;
    background: #111111;
    color: #ffffff;
    border: none;
    cursor: pointer;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    border-radius: 0;
    transition: all var(--transition-smooth);
    margin-top: var(--space-xs);
  }

  .submit-btn:hover {
    background: #2a2a2a;
    transform: translateY(-2px);
  }

  .submit-btn[disabled] {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  .arrow {
    transition: transform var(--transition-smooth);
  }

  .submit-btn:hover .arrow {
    transform: translateX(4px);
  }

  /* Status message banner */
  .form-status {
    padding: 12px 14px;
    border-radius: 4px;
    font-size: 0.9rem;
    line-height: 1.5;
    font-family: var(--font-text);
  }

  .form-status.success {
    background: rgba(39, 201, 63, 0.12);
    border: 1px solid rgba(39, 201, 63, 0.35);
    color: #15803d;
  }

  .form-status.error {
    background: rgba(255, 77, 77, 0.12);
    border: 1px solid rgba(255, 77, 77, 0.35);
    color: #b91c1c;
  }
</style>