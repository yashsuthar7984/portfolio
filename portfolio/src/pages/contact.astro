---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact">
  <section class="contact-section">
    <div class="content-wrapper">
      <h1 class="title">Contact</h1>
      <p class="description">
        Reach out for software contracts, creative collaborations, or general inquiries.
      </p>

      <!-- Direct Contact Details -->
      <div class="contact-details">
        <h3>Yash Suthar</h3>
        <a href="mailto:yashsuthar7984@gmail.com" class="email-link">
          yashsuthar7984@gmail.com
        </a>
      </div>
      
      <!-- Secure Contact Form (Basic HTML Method) -->
      <form action="https://formspree.io/f/moejwjzl" method="POST" class="contact-form">
        <input type="text" name="name" placeholder="Name" required />
        <input type="email" name="email" placeholder="Email" required />
        <textarea name="message" placeholder="Message" rows="5" required></textarea>
        <!-- Formspree hidden configuration -->
        <input type="hidden" name="_subject" value="New submission from your portfolio!" />
        <button type="submit">Send Message</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-section {
    padding: var(--space-2xl) 0;
    display: flex;
    justify-content: center;
    min-height: 70vh;
  }
  
  .content-wrapper {
    max-width: 600px;
    width: 100%;
    margin: 0 auto;
    padding: 0 var(--space-md);
    text-align: center;
  }

  .title {
    font-size: clamp(3rem, 6vw, 5rem);
    margin-bottom: var(--space-md);
    letter-spacing: -0.02em;
  }

  .description {
    color: var(--color-text-muted);
    font-size: 1.15rem;
    margin-bottom: var(--space-lg);
  }

  /* Direct Contact Details Styling */
  .contact-details {
    margin-bottom: var(--space-xl);
    padding: var(--space-lg);
    background: rgba(255, 255, 255, 0.02);
    border: var(--divider);
    border-radius: 8px;
  }

  .contact-details h3 {
    margin-bottom: var(--space-xs);
    font-size: 1.5rem;
    letter-spacing: 0.05em;
  }

  .email-link {
    color: var(--color-accent);
    font-family: var(--font-text);
    font-size: 1.1rem;
    transition: opacity var(--transition-smooth);
  }

  .email-link:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  /* Form Styling */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    text-align: left;
  }

  .contact-form input,
  .contact-form textarea {
    padding: var(--space-md);
    background: var(--color-surface);
    border: var(--divider);
    color: var(--color-text-primary);
    font-family: var(--font-text);
    font-size: 1rem;
    border-radius: 4px;
    width: 100%;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .contact-form button {
    padding: var(--space-md);
    background: var(--color-accent);
    color: white;
    border: none;
    cursor: pointer;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 1rem;
    letter-spacing: 0.05em;
    border-radius: 4px;
    transition: opacity var(--transition-smooth);
    margin-top: var(--space-sm);
  }

  .contact-form button:hover {
    opacity: 0.85;
  }
</style>