---
import { siteConfig } from '../../data/site.js';
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo">{siteConfig.name}</a>
    <nav class="site-nav">
     <nav class="site-nav">
  <a href="/work/code">Code</a>
  <a href="/work/hobbies">Hobbies</a>
  <a href="/about">About</a>
  <a href="/contact">Contact</a>
</nav>
    </nav>
  </div>
</header>
<style>
  .site-header { border-bottom: var(--divider); padding: var(--space-md) var(--space-lg); position: sticky; top: 0; background: var(--color-bg); z-index: 10; }
  .header-inner { display: flex; justify-content: space-between; align-items: center; max-width: 1400px; margin: 0 auto; }
  .logo { font-family: var(--font-display); font-weight: 600; font-size: 1.25rem; text-transform: uppercase; }
  .site-nav { display: flex; gap: var(--space-lg); }
  .site-nav a { font-family: var(--font-display); font-size: 0.875rem; text-transform: uppercase; color: var(--color-text-muted); transition: color var(--transition-smooth); }
  .site-nav a:hover { color: var(--color-text-primary); }
</style>
